# Database connection string (PostgreSQL e.g. Neon, Supabase, AWS RDS)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to encrypt cookies, sessions, and auth tokens (generate a 32+ character random string)
PAYLOAD_SECRET=your-secure-payload-secret-here

# Public URL of the deployed application (used for canonical URLs, sitemaps, and social share metadata)
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# Claude Automation (Step 6)
# Official Anthropic API Key (server-side only, never exposed to client)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Approved Client RSS Feeds (JSON array or comma-separated URLs)
# E.g. '["https://www.realestate.com.au/news/feed/", "https://www.theguardian.com/australia-news/housing/rss"]'
# Defaults to the 11 client-verified RSS feeds if left empty.
APPROVED_RSS_FEEDS=

# Secret token securing Vercel Cron and manual triggers (/api/cron/claude)
CRON_SECRET=cron-secret@@2026

# Optional Claude Model override (defaults to claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Photo Integration (Step 7 - Unsplash)
# Official Unsplash Access Key (server-side only, never exposed to client)
# Obtains landscape photos >= 1200px matching Claude photoSearchWords
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Newsletter Integration (Step 8 - Klaviyo)
# Official Klaviyo Private API Key (server-side only, never exposed to browser)
# Subscribes valid emails to client's newsletter list
KLAVIYO_PRIVATE_API_KEY=pk_your-klaviyo-private-key-here

# Client's Klaviyo List ID for Charlie News Newsletter subscribers
KLAVIYO_LIST_ID=your-klaviyo-list-id-here